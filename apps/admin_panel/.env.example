# ============================================================================
# Delivery Platform — Admin Panel + Backend environment variables
# Copy to .env.local for development, or set in Vercel Project Settings.
# ============================================================================

# Database — PostgreSQL with PostGIS recommended for production.
# For local dev you can use a free Neon / Supabase / Railway PostgreSQL URL.
DATABASE_URL="postgresql://user:password@localhost:5432/delivery_platform?schema=public"

# Auth — used to sign admin session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-32-byte-random-string"

# API keys for Flutter app -> backend authentication (comma-separated).
# If unset, the API is open in dev mode. ALWAYS set in production.
APP_API_KEYS=""

# OTP providers (configurable; only one needs to be set)
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Maps
GOOGLE_MAPS_API_KEY=""
MAPMYINDIA_API_KEY=""

# Push notifications
FIREBASE_SERVER_KEY=""
FIREBASE_PROJECT_ID=""

# Analytics
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# App
NEXT_PUBLIC_APP_NAME="Delivery Platform"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

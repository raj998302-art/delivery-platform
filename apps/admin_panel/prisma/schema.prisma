// ============================================================================
// Delivery Platform — Prisma Schema
// Multi-service delivery platform (Porter / Swiggy / Uber / Rapido style)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PARTNER
  ADMIN
  SUPPORT
}

enum ServiceType {
  PARCEL
  FOOD
  GROCERY
  MEDICINE
  BIKE
  AUTO
  MINI_TRUCK
  TRUCK
}

enum OrderState {
  DRAFT
  QUOTE_CREATED
  PAYMENT_PENDING
  CONFIRMED
  SEARCHING_PARTNER
  PARTNER_ASSIGNED
  PARTNER_ACCEPTED
  PARTNER_ARRIVING
  PARTNER_ARRIVED
  PICKUP_VERIFICATION
  PICKED_UP
  IN_TRANSIT
  ARRIVING
  DELIVERY_VERIFICATION
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
  REFUNDED
}

enum VehicleType {
  BIKE
  SCOOTER
  AUTO
  MINI_TRUCK
  TRUCK
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  OFFLINE
  ONLINE
  ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  WALLET
  NETBANKING
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum WalletTxnType {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum PackageType {
  DOCUMENT
  SMALL_PARCEL
  MEDIUM_PARCEL
  LARGE_PARCEL
  FOOD
  OTHER
}

// ----------------------------------------------------------------------------
// USERS & AUTH
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid()) @map("_id")
  phone         String    @unique
  email         String?
  passwordHash  String?
  name          String?
  role          UserRole  @default(CUSTOMER)
  googleId      String?
  isGuest       Boolean   @default(false)
  isBlocked     Boolean   @default(false)
  emailVerified DateTime?
  phoneVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  profile       UserProfile?
  addresses     UserAddress[]
  orders        Order[]
  ratingsGiven  Rating[]          @relation("RatingFromUser")
  notifications Notification[]
  tickets       SupportTicket[]
  wallets       Wallet[]
  refreshTokens RefreshToken[]
  otpRequests   OtpRequest[]
  partners      Partner[]

  @@map("users")
}

model UserProfile {
  id          String   @id @default(cuid()) @map("_id")
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  avatarUrl   String?
  gender      String?
  dob         DateTime?
  language    String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

model UserAddress {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  line1       String
  line2       String?
  city        String
  state       String?
  postalCode  String?
  country     String   @default("India")
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_addresses")
}

model RefreshToken {
  id                 String   @id @default(cuid()) @map("_id")
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token              String   @unique
  deviceFingerprint  String?
  userAgent          String?
  ipAddress          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime @default(now())

  @@map("refresh_tokens")
}

model OtpRequest {
  id           String   @id @default(cuid()) @map("_id")
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  channel      String   @default("sms")
  codeHash     String
  attempts     Int      @default(0)
  verified     Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("otp_requests")
}

// ----------------------------------------------------------------------------
// PARTNERS
// ----------------------------------------------------------------------------

model Partner {
  id              String        @id @default(cuid()) @map("_id")
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  phone           String        @unique
  email           String?
  firstName       String
  lastName        String
  avatarUrl       String?
  status          PartnerStatus @default(PENDING)
  rating          Float         @default(5.0)
  totalRatings    Int           @default(0)
  acceptanceRate  Float         @default(0)
  completionRate  Float         @default(0)
  totalDeliveries Int           @default(0)
  totalEarnings   Float       @default(0)
  isOnline        Boolean       @default(false)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  serviceZoneId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  profile         PartnerProfile?
  documents       PartnerDocument[]
  vehicles        PartnerVehicle[]
  assignments     PartnerAssignment[]
  orders          Order[]
  ratingsReceived Rating[]       @relation("RatingFromPartner")
  wallets         Wallet[]
  notifications   Notification[]
  tickets         SupportTicket[]
  locationUpdates LocationUpdate[]

  @@map("partners")
}

model PartnerProfile {
  id             String   @id @default(cuid()) @map("_id")
  partnerId      String   @unique
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  dob            DateTime?
  gender         String?
  aadhaarNumber  String?
  panNumber      String?
  drivingLicense String?
  bankAccount    String?
  ifsc           String?
  upiId          String?
  onboardedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("partner_profiles")
}

model PartnerDocument {
  id          String   @id @default(cuid()) @map("_id")
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type        String
  url         String
  status      String   @default("PENDING")
  verifiedAt  DateTime?
  verifiedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("partner_documents")
}

model PartnerVehicle {
  id                 String       @id @default(cuid()) @map("_id")
  partnerId          String
  partner            Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type               VehicleType
  registrationNumber String       @unique
  model              String?
  color              String?
  capacityKg         Int          @default(0)
  isPrimary          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  documents          PartnerVehicleDocument[]

  @@map("partner_vehicles")
}

model PartnerVehicleDocument {
  id          String             @id @default(cuid()) @map("_id")
  vehicleId   String
  vehicle     PartnerVehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  url         String
  status      String             @default("PENDING")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("partner_vehicle_documents")
}

// ----------------------------------------------------------------------------
// SERVICES & VEHICLES
// ----------------------------------------------------------------------------

model Service {
  id            String      @id @default(cuid()) @map("_id")
  type          ServiceType @unique
  name          String
  description   String?
  icon          String?
  isActive      Boolean     @default(true)
  baseFare      Int         @default(0)
  perKm         Int         @default(0)
  perMin        Int         @default(0)
  platformFee   Int         @default(0)
  taxPercent    Float       @default(0)
  minFare       Int         @default(0)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vehicleTypes  ServiceVehicleType[]
  orders        Order[]

  @@map("services")
}

model VehicleTypeConfig {
  id           String      @id @default(cuid()) @map("_id")
  type         VehicleType @unique
  name         String
  icon         String?
  capacityKg   Int         @default(0)
  multiplier   Float       @default(1.0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  services     ServiceVehicleType[]

  @@map("vehicle_types")
}

model ServiceVehicleType {
  id               String            @id @default(cuid()) @map("_id")
  serviceId        String
  vehicleType      VehicleType
  service          Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleTypeConf  VehicleTypeConfig  @relation(fields: [vehicleType], references: [type])
  createdAt        DateTime           @default(now())

  @@unique([serviceId, vehicleType])
  @@map("service_vehicle_types")
}

// ----------------------------------------------------------------------------
// ORDERS
// ----------------------------------------------------------------------------

model Order {
  id                 String         @id @default(cuid()) @map("_id")
  code               String         @unique
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  partnerId          String?
  partner            Partner?       @relation(fields: [partnerId], references: [id])
  serviceId          String
  service            Service        @relation(fields: [serviceId], references: [id])
  state              OrderState     @default(DRAFT)
  stateHistory       OrderStatusHistory[]
  packageType        PackageType    @default(SMALL_PARCEL)
  packageDescription String?
  packageWeightKg    Float          @default(0)
  fragile            Boolean        @default(false)
  photoUrl           String?
  pickupLat          Float
  pickupLng          Float
  pickupAddress      String
  pickupInstructions String?
  dropLat            Float
  dropLng            Float
  dropAddress        String
  dropInstructions   String?
  distanceKm         Float
  estimatedMinutes   Int
  baseFare           Int
  distanceFare       Int
  timeFare           Int
  platformFee        Int
  taxAmount          Int
  surgeFee           Int            @default(0)
  discountAmount     Int            @default(0)
  totalAmount        Int
  currency           String         @default("INR")
  paymentMethod      PaymentMethod  @default(UPI)
  paymentStatus      PaymentStatus  @default(PENDING)
  scheduledAt        DateTime?
  isInstant          Boolean        @default(true)
  cancelledReason    String?
  cancelledBy        String?
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items              OrderItem[]
  assignments        PartnerAssignment[]
  payments           Payment[]
  tracking           TrackingSession?
  rating             Rating?

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  quantity    Int      @default(1)
  price       Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model OrderStatusHistory {
  id          String     @id @default(cuid()) @map("_id")
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  state       OrderState
  actor       String?
  note        String?
  createdAt   DateTime   @default(now())

  @@map("order_status_history")
}

model OrderLocation {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String
  latitude    Float
  longitude   Float
  heading     Float?
  speed        Float?
  recordedAt  DateTime @default(now())

  @@map("order_locations")
}

model PartnerAssignment {
  id           String           @id @default(cuid()) @map("_id")
  orderId      String
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId    String
  partner      Partner          @relation(fields: [partnerId], references: [id])
  status       AssignmentStatus @default(PENDING)
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())

  @@map("partner_assignments")
}

// ----------------------------------------------------------------------------
// TRACKING
// ----------------------------------------------------------------------------

model TrackingSession {
  id           String   @id @default(cuid()) @map("_id")
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId    String?
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  isActive     Boolean  @default(true)

  updates      LocationUpdate[]

  @@map("tracking_sessions")
}

model LocationUpdate {
  id           String            @id @default(cuid()) @map("_id")
  sessionId    String?
  session      TrackingSession?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  partnerId    String?
  partner      Partner?          @relation(fields: [partnerId], references: [id])
  latitude     Float
  longitude    Float
  heading      Float?
  speed        Float?
  recordedAt   DateTime          @default(now())

  @@map("location_updates")
}

// ----------------------------------------------------------------------------
// PRICING
// ----------------------------------------------------------------------------

model PricingRule {
  id              String       @id @default(cuid()) @map("_id")
  serviceId       String?
  vehicleType     VehicleType?
  baseFare        Int          @default(0)
  perKm           Int          @default(0)
  perMin          Int          @default(0)
  waitingCharge   Int          @default(0)
  platformFee     Int          @default(0)
  taxPercent      Float        @default(0)
  minFare         Int          @default(0)
  surgeMultiplier Float        @default(1.0)
  priority        Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("pricing_rules")
}

model FareQuote {
  id              String   @id @default(cuid()) @map("_id")
  userId          String?
  serviceId       String
  vehicleType     VehicleType
  pickupLat       Float
  pickupLng       Float
  dropLat         Float
  dropLng         Float
  distanceKm      Float
  estimatedMinutes Int
  baseFare        Int
  distanceFare    Int
  timeFare        Int
  platformFee     Int
  taxAmount       Int
  surgeFee        Int
  discountAmount  Int
  totalAmount     Int
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  @@map("fare_quotes")
}

model SurgeRule {
  id            String    @id @default(cuid()) @map("_id")
  serviceZoneId String?
  serviceId     String?
  multiplier    Float
  startTime     DateTime?
  endTime       DateTime?
  daysOfWeek    String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("surge_rules")
}

model ServiceZone {
  id          String   @id @default(cuid()) @map("_id")
  name        String   @unique
  city        String
  minLat      Float
  maxLat      Float
  minLng      Float
  maxLng      Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_zones")
}

// ----------------------------------------------------------------------------
// PAYMENTS & WALLETS
// ----------------------------------------------------------------------------

model Payment {
  id              String         @id @default(cuid()) @map("_id")
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id])
  amount          Int
  currency        String         @default("INR")
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  provider        String?
  providerTxnId   String?
  gatewayResponse Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("payments")
}

model Wallet {
  id            String   @id @default(cuid()) @map("_id")
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId     String?
  partner       Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  balance       Float  @default(0)
  currency      String   @default("INR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  WalletTransaction[]
  withdrawals   WithdrawalRequest[]

  @@map("wallets")
}

model WalletTransaction {
  id            String        @id @default(cuid()) @map("_id")
  walletId      String
  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTxnType
  amount        Float      
  balanceAfter  Float      
  description   String?
  reference     String?
  createdAt     DateTime      @default(now())

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id          String            @id @default(cuid()) @map("_id")
  walletId    String
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float          
  status      WithdrawalStatus  @default(PENDING)
  method      String            @default("UPI")
  reference   String?
  processedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("withdrawal_requests")
}

// ----------------------------------------------------------------------------
// COUPONS / PROMOTIONS
// ----------------------------------------------------------------------------

model Coupon {
  id            String    @id @default(cuid()) @map("_id")
  code          String    @unique
  description   String?
  type          String    @default("FLAT")
  value         Int
  maxDiscount   Int?
  minOrderValue Int       @default(0)
  expiresAt     DateTime?
  usageLimit    Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("coupons")
}

// ----------------------------------------------------------------------------
// RATINGS & REVIEWS
// ----------------------------------------------------------------------------

model Rating {
  id          String   @id @default(cuid()) @map("_id")
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  fromUserId  String?
  fromUser    User?    @relation("RatingFromUser", fields: [fromUserId], references: [id])
  toPartnerId String?
  toPartner   Partner? @relation("RatingFromPartner", fields: [toPartnerId], references: [id])
  score       Int
  comment     String?
  createdAt   DateTime @default(now())

  @@map("ratings")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// ----------------------------------------------------------------------------
// SUPPORT
// ----------------------------------------------------------------------------

model SupportTicket {
  id          String       @id @default(cuid()) @map("_id")
  code        String       @unique
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  partnerId   String?
  partner     Partner?     @relation(fields: [partnerId], references: [id])
  orderId     String?
  subject     String
  category    String       @default("GENERAL")
  priority    String       @default("NORMAL")
  status      TicketStatus @default(OPEN)
  assignedTo  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages    SupportMessage[]

  @@map("support_tickets")
}

model SupportMessage {
  id            String         @id @default(cuid()) @map("_id")
  ticketId      String
  ticket        SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromId        String
  fromRole      String
  body          String
  attachmentUrl String?
  createdAt     DateTime       @default(now())

  @@map("support_messages")
}

// ----------------------------------------------------------------------------
// ADMIN
// ----------------------------------------------------------------------------

model AdminUser {
  id           String   @id @default(cuid()) @map("_id")
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @default(cuid()) @map("_id")
  actorId     String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// SETTINGS & FEATURE FLAGS
// ----------------------------------------------------------------------------

model Setting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     String
  category  String   @default("GENERAL")
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FeatureFlag {
  id              String   @id @default(cuid()) @map("_id")
  key             String   @unique
  name            String
  description     String?
  enabled         Boolean  @default(false)
  rolloutPercent  Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("feature_flags")
}
